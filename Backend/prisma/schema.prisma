datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  telefone     String?  
  senha        String   
  avatarPath   String?  
  criadoEm     DateTime @default(now()) 
  atualizadoEm DateTime @updatedAt      

  imoveis      Imovel[]
  reservas  Reserva[] @relation("ReservasComoHospede")
  avaliacoes Avaliacao[] @relation("AvaliacoesFeitas")
}

model Periodo {
  id       Int      @id @default(autoincrement())
  inicio   DateTime
  fim      DateTime
  imovelId Int
  imovel   Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
}

model Imovel {
  id            Int      @id @default(autoincrement())
  titulo        String
  tipo          String
  descricao     String   @db.Text
  cidade        String
  bairro        String
  endereco      String
  cep           String
  preco         Float
  tipoCobranca  String
  capacidade    String
  quartos       Int
  banheiros     Int
  vagas         Int
  proximoCentro Boolean
  proximoPraia  Boolean

  // Comodidades
  hasWifi           Boolean
  hasMaquinaLavar   Boolean
  hasArCondicionado Boolean
  hasChurrascaria   Boolean
  hasEstacionamento Boolean
  hasElevador       Boolean
  hasPiscina        Boolean
  hasPortaria24h    Boolean
  hasTv             Boolean

  // Regras
  aceitaPets     Boolean
  permiteFestas  Boolean
  acessibilidade Boolean
  naoFumante     Boolean

  // Relacionamentos
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  imagens   Imagem[]
  periodos  Periodo[]
  reservas  Reserva[]
  avaliacoes Avaliacao[]
}

model Reserva {
  id         Int      @id @default(autoincrement())
  inicio     DateTime
  fim        DateTime
  status     String   @default("Pendente")
  criadoEm  DateTime @default(now())

  imovelId   Int
  imovel     Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  hospedeId  Int
  hospede    Usuario  @relation("ReservasComoHospede", fields: [hospedeId], references: [id], onDelete: Cascade)
}

model Imagem {
  id       Int    @id @default(autoincrement())
  url      String
  imovelId Int
  imovel   Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)
}

model Avaliacao {
  id          Int      @id @default(autoincrement())
  nota        Float
  comentario  String   @db.Text
  criadoEm   DateTime @default(now())

  imovelId    Int
  imovel      Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  autorId     Int
  autor       Usuario  @relation("AvaliacoesFeitas", fields: [autorId], references: [id], onDelete: Cascade)
}